# ==============================================
#  Plantilla de variables de entorno — StudyBank
#  Copia este archivo como .env y rellena los valores.
#  El .env real NUNCA se sube a Git.
# ==============================================

# ---- Django ----
# Genera una con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=pega-aqui-tu-clave-secreta

# True en local (muestra errores detallados), False en producción
DEBUG=True

# Dominios permitidos, separados por coma.
# En local: localhost,127.0.0.1
# En AWS EC2: la IP pública de la instancia, por ejemplo 54.12.34.56
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Producción en AWS EC2 (dejar vacío / False en local) ----
# Orígenes que pueden enviar formularios. En EC2: http://IP_PUBLICA
CSRF_TRUSTED_ORIGINS=
# True en EC2 para que Django sirva las fotos de perfil y los archivos subidos
# cuando DEBUG=False y no se usa Cloudflare R2
SERVE_MEDIA=False

# ---- Cloudflare R2 (almacenamiento de PDFs y avatares) ----
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=studybank-media
R2_ENDPOINT_URL=https://TU_ACCOUNT_ID.r2.cloudflarestorage.com