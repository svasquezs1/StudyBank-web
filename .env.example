# ==============================================
#  Plantilla de variables de entorno — StudyBank
#  Copia este archivo como .env y rellena los valores.
#  El .env real NUNCA se sube a Git.
# ==============================================

# ---- Django ----
# Genera una con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=pega-aqui-tu-clave-secreta

# True en local (muestra errores detallados), False en producción
DEBUG=True

# Dominios permitidos, separados por coma.
# En local: localhost,127.0.0.1
# En producción: TU_USUARIO.pythonanywhere.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Cloudflare R2 (almacenamiento de PDFs y avatares) ----
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=studybank-media
R2_ENDPOINT_URL=https://TU_ACCOUNT_ID.r2.cloudflarestorage.com