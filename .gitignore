# =====================================================================
#  .gitignore — StudyBank-web (Django)
#  Le dice a Git qué archivos NO subir al repositorio.
#  Base: plantilla oficial de Python + añadidos propios del proyecto.
# =====================================================================


# ---------------------------------------------------------------------
#  ARCHIVOS ESPECÍFICOS DE STUDYBANK  (¡lo más importante para el equipo!)
# ---------------------------------------------------------------------

# Base de datos local de SQLite: cada integrante tiene la suya con sus
# propios datos de prueba. Compartirla causaría conflictos.
db.sqlite3
db.sqlite3-journal

# Secretos y variables de entorno (SECRET_KEY, llaves de Cloudflare R2).
# NUNCA debe subirse. El .env.example (plantilla vacía) SÍ va al repo.
.env
.envrc

# Archivos subidos por usuarios en local (PDFs de apuntes, avatares).
# En producción viven en Cloudflare R2, no en el repositorio.
media/

# Estáticos recolectados por 'collectstatic'. Se regeneran solos;
# no tiene sentido versionarlos.
staticfiles/


# ---------------------------------------------------------------------
#  ENTORNOS VIRTUALES
#  Cada quien crea el suyo con 'python -m venv'. Pesan mucho y son
#  específicos de cada máquina.
# ---------------------------------------------------------------------
.venv
venv/
env/
ENV/
env.bak/
venv.bak/


# ---------------------------------------------------------------------
#  ARCHIVOS COMPILADOS DE PYTHON
#  Los genera Python al ejecutar; no son código fuente.
# ---------------------------------------------------------------------
__pycache__/
*.py[codz]
*$py.class

# Extensiones en C compiladas
*.so


# ---------------------------------------------------------------------
#  EMPAQUETADO Y DISTRIBUCIÓN
#  Carpetas que se generan al construir o distribuir paquetes Python.
# ---------------------------------------------------------------------
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller (empaquetado de ejecutables)
*.manifest
*.spec

# Logs de instalación de pip
pip-log.txt
pip-delete-this-directory.txt


# ---------------------------------------------------------------------
#  PRUEBAS Y COBERTURA DE CÓDIGO
#  Reportes que generan las herramientas de testing.
# ---------------------------------------------------------------------
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cover
.hypothesis/
.pytest_cache/
cover/


# ---------------------------------------------------------------------
#  DJANGO
#  Logs y configuración local que no debe compartirse.
# ---------------------------------------------------------------------
*.log
local_settings.py


# ---------------------------------------------------------------------
#  TRADUCCIONES
#  Archivos compilados de internacionalización.
# ---------------------------------------------------------------------
*.mo
*.pot


# ---------------------------------------------------------------------
#  HERRAMIENTAS Y FRAMEWORKS VARIOS
#  Cachés y estados locales de utilidades que podrían usarse.
# ---------------------------------------------------------------------

# Flask
instance/
.webassets-cache

# Scrapy
.scrapy

# Sphinx (documentación)
docs/_build/

# PyBuilder
.pybuilder/
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# Celery (tareas en segundo plano)
celerybeat-schedule
celerybeat.pid

# Redis
*.rdb
*.aof
*.pid

# RabbitMQ
mnesia/
rabbitmq/
rabbitmq-data/

# ActiveMQ
activemq-data/

# SageMath
*.sage.py


# ---------------------------------------------------------------------
#  VERIFICADORES DE TIPOS Y LINTERS
#  Cachés de análisis estático de código.
# ---------------------------------------------------------------------
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
cython_debug/
.ruff_cache/


# ---------------------------------------------------------------------
#  GESTORES DE DEPENDENCIAS Y ENTORNOS
#  Estados locales; los archivos .lock suelen SÍ versionarse (por eso
#  están comentados). Ver notas de cada herramienta.
# ---------------------------------------------------------------------

# pyenv — descomenta si NO quieres fijar la versión de Python
# .python-version

# pipenv — se recomienda versionar Pipfile.lock
# Pipfile.lock

# UV — se recomienda versionar uv.lock
# uv.lock

# poetry — se recomienda versionar poetry.lock
# poetry.lock
# poetry.toml

# pdm
# pdm.lock
# pdm.toml
.pdm-python
.pdm-build/

# pixi
# pixi.lock
.pixi

# PEP 582
__pypackages__/


# ---------------------------------------------------------------------
#  EDITORES E IDEs
#  Configuración personal de cada desarrollador.
# ---------------------------------------------------------------------

# VS Code — ignorado para que cada quien tenga su propia config
.vscode/

# PyCharm / JetBrains — ignorado igual que VS Code
.idea/

# Archivo temporal de ejecución parcial de código
tempCodeRunnerFile.py

# macOS
.DS_Store

# Spyder
.spyderproject
.spyproject

# Rope
.ropeproject


# ---------------------------------------------------------------------
#  OTRAS HERRAMIENTAS
# ---------------------------------------------------------------------

# mkdocs
/site

# Abstra (automatización)
.abstra/

# PyPI
.pypirc

# Marimo
marimo/_static/
marimo/_lsp/
__marimo__/

# Streamlit
.streamlit/secrets.toml